# Configuration du bandeau, lue à la compilation.
# Copier en .env (jamais versionné) :  cp .env.example .env
# Valeurs avec espaces ou caractères spéciaux : entre guillemets "..." (ou '...' si elles contiennent ").
# Après modification : idf.py build (la configuration est relue automatiquement).

# ── Wi-Fi (obligatoire) ──
WIFI_SSID="Mon Wi-Fi"
WIFI_PASSWORD="change-moi"

# ── Identité ──
DEVICE_NAME="Bandeau chambre"   # nom de l'appareil dans Home Assistant
DEVICE_ID=bandeau_chambre       # minuscules, chiffres et _ : topics MQTT et identifiants HA
DEVICE_HOSTNAME=led-chambre     # nom réseau : http://led-chambre.local/

# ── Bandeau ──
LED_GPIO=22
LED_COUNT=150                   # nombre de pixels (WS2811 en 12 V : 1 pixel = 1 puce = 3 LED)
LED_MODEL=WS2812                # WS2812 (aussi WS2811 à 800 kHz) ou SK6812
LED_COLOR_ORDER=GRB             # ordre des couleurs sur le fil : GRB, RGB, BRG...
LED_MAX_BRIGHTNESS=255          # plafond global, pour ménager l'alimentation (1 à 255)
LED_GAMMA=0                     # 1 = correction gamma : dégradés plus réguliers à faible luminosité
DEFAULT_TRANSITION_MS=300       # fondu par défaut entre deux réglages (0 = immédiat)

# ── MQTT / Home Assistant (MQTT_URI vide = MQTT désactivé) ──
MQTT_URI=mqtt://192.168.1.111:1883
MQTT_USER=homelab
MQTT_PASSWORD="change-moi"
MQTT_BASE_TOPIC=led/bandeau_chambre
HA_DISCOVERY_PREFIX=homeassistant

# ── Mise à jour par le Wi-Fi (vide = désactivée) ──
OTA_PASSWORD="change-moi"
