CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Deux emplacements d'application pour la mise à jour par le Wi-Fi (OTA)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Si une nouvelle version ne se connecte pas au Wi-Fi, retour automatique à la précédente
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# En-têtes HTTP un peu plus longs (requête OTA envoyée par curl)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
