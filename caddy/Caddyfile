# Caddy obtient automatiquement les certificats HTTPS des noms *.ts.net
# via le socket tailscaled monté dans le conteneur.

# Open WebUI → https://serveur.ton-tailnet.ts.net
{$TS_HOSTNAME} {
	reverse_proxy open-webui:8080
}

# Home Assistant → https://serveur.ton-tailnet.ts.net:8443
{$TS_HOSTNAME}:8443 {
	reverse_proxy host.docker.internal:8123
}
