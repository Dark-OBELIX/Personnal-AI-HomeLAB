# Copier en .env puis remplir :  cp .env.example .env && chmod 600 .env

TZ=Europe/Paris

# Modèle local (Ollama)
OLLAMA_MODEL=qwen3:4b

# PostgreSQL — générer le mot de passe avec : openssl rand -hex 24
POSTGRES_USER=homelab
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=homelab

# Broker MQTT (Home Assistant, bandeau LED) — générer avec : openssl rand -hex 16
MQTT_USER=homelab
MQTT_PASSWORD=change-moi

# ── Bot Discord (étape 2, à remplir plus tard) ──
# Jeton du bot : Discord Developer Portal → ton application → Bot → Reset Token
DISCORD_TOKEN=
# Identifiants Discord autorisés, séparés par des virgules (Hugo, Flo)
# Discord → Paramètres → Avancés → Mode développeur, puis clic droit sur un profil → Copier l'identifiant
DISCORD_ALLOWED_USERS=

# Jeton Home Assistant : profil utilisateur → Sécurité → Jetons d'accès longue durée
HA_TOKEN=
