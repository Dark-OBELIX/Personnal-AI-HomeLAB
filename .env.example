# Copier en .env puis remplir :  cp .env.example .env && chmod 600 .env

TZ=Europe/Paris

# Tailscale — IP et nom de la machine dans ton tailnet
#   tailscale ip -4
#   tailscale status --json | jq -r .Self.DNSName   (sans le point final)
TS_IP=100.x.y.z
TS_HOSTNAME=serveur.ton-tailnet.ts.net

# Clé API Anthropic (console.anthropic.com) — pense à fixer une limite de dépense
ANTHROPIC_API_KEY=sk-ant-...

# Open WebUI — générer avec : openssl rand -hex 32
WEBUI_SECRET_KEY=change-moi

# PostgreSQL — générer le mot de passe avec : openssl rand -base64 24
POSTGRES_USER=homelab
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=homelab
